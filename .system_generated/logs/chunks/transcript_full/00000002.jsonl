{"step_index":58,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-05T16:35:17Z","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Dark-themed, navigable Theory of Computation study website. Contains Unit 1-3 full notes, complete PYP T1 solutions with all worked answers, and 4 × 6-question sample papers. Features sidebar navigation, smooth scrolling, collapsible sections, and a print-ready sample paper view.","UserFacing":false},"CodeContent":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>TOC Study Hub — Theory of Computation</title>\n<style>\n:root {\n  --bg: #07090f;\n  --bg2: #0d1117;\n  --bg3: #161b22;\n  --bg4: #1c2128;\n  --bg5: #21262d;\n  --sidebar: #080c14;\n  --border: #21262d;\n  --border2: #30363d;\n  --accent: #818cf8;\n  --accent2: #6366f1;\n  --cyan: #22d3ee;\n  --amber: #fbbf24;\n  --green: #4ade80;\n  --red: #f87171;\n  --purple: #c084fc;\n  --text: #e6edf3;\n  --text2: #b1bac4;\n  --text3: #7d8590;\n  --active-bg: rgba(99,102,241,0.12);\n  --active-border: #6366f1;\n  --card-glow: rgba(99,102,241,0.06);\n}\n*{margin:0;padding:0;box-sizing:border-box;}\nhtml{scroll-behavior:smooth;}\nbody{\n  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;\n  background:var(--bg);color:var(--text);\n  display:flex;min-height:100vh;font-size:15px;line-height:1.7;\n}\n\n/* ── SIDEBAR ── */\n.sidebar{\n  width:268px;min-width:268px;background:var(--sidebar);\n  border-right:1px solid var(--border);\n  position:sticky;top:0;height:100vh;overflow-y:auto;\n  display:flex;flex-direction:column;z-index:100;\n  scrollbar-width:thin;scrollbar-color:var(--bg5) transparent;\n}\n.sidebar::-webkit-scrollbar{width:4px;}\n.sidebar::-webkit-scrollbar-thumb{background:var(--bg5);border-radius:2px;}\n.logo{\n  padding:22px 20px 16px;border-bottom:1px solid var(--border);\n  display:flex;align-items:center;gap:10px;\n}\n.logo-icon{font-size:24px;}\n.logo-text{font-size:17px;font-weight:700;letter-spacing:-.3px;color:var(--text);}\n.logo-sub{font-size:11px;color:var(--text3);margin-top:1px;}\n\n.nav{padding:10px 0 20px;}\n.nav-group{margin-bottom:4px;}\n.nav-group-title{\n  padding:8px 20px 4px;font-size:10.5px;font-weight:600;\n  color:var(--text3);text-transform:uppercase;letter-spacing:.08em;\n}\n.nav-item{\n  display:flex;align-items:center;gap:8px;\n  padding:7px 20px;cursor:pointer;transition:.15s;\n  font-size:13.5px;color:var(--text2);text-decoration:none;\n  border-left:2px solid transparent;\n}\n.nav-item:hover{color:var(--text);background:rgba(255,255,255,.04);}\n.nav-item.active{\n  color:var(--accent);background:var(--active-bg);\n  border-left-color:var(--accent2);\n}\n.nav-item .icon{font-size:14px;min-width:16px;text-align:center;}\n.nav-sub{margin-left:0;}\n.nav-sub .nav-item{\n  padding-left:40px;font-size:13px;\n}\n\n/* ── MAIN ── */\n.main{flex:1;min-width:0;overflow-x:hidden;}\n\n/* ── TOPBAR ── */\n.topbar{\n  position:sticky;top:0;z-index:50;\n  background:rgba(7,9,15,.85);backdrop-filter:blur(12px);\n  border-bottom:1px solid var(--border);\n  padding:12px 40px;display:flex;align-items:center;justify-content:space-between;\n}\n.topbar-title{font-size:14px;color:var(--text3);}\n.topbar-badge{\n  font-size:11px;padding:3px 10px;border-radius:20px;\n  background:rgba(99,102,241,.2);color:var(--accent);border:1px solid rgba(99,102,241,.3);\n  font-weight:600;\n}\n\n/* ── CONTENT ── */\n.content{padding:48px 48px 80px;max-width:1000px;}\n\n/* ── HERO ── */\n.hero{\n  background:linear-gradient(135deg,#0d1117 0%,#131a2e 50%,#0a1020 100%);\n  border:1px solid var(--border2);border-radius:16px;\n  padding:48px;margin-bottom:48px;position:relative;overflow:hidden;\n}\n.hero::before{\n  content:'';position:absolute;top:-80px;right:-60px;\n  width:300px;height:300px;\n  background:radial-gradient(circle,rgba(99,102,241,.15) 0%,transparent 70%);\n}\n.hero-tag{\n  display:inline-block;font-size:11px;font-weight:600;letter-spacing:.08em;\n  text-transform:uppercase;color:var(--cyan);margin-bottom:12px;\n}\n.hero h1{font-size:36px;font-weight:800;letter-spacing:-.5px;margin-bottom:10px;\n  background:linear-gradient(135deg,#e6edf3 30%,#818cf8 100%);\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n}\n.hero p{color:var(--text2);font-size:15px;max-width:560px;margin-bottom:28px;}\n.hero-chips{display:flex;flex-wrap:wrap;gap:8px;}\n.chip{\n  padding:5px 14px;border-radius:20px;font-size:12px;font-weight:500;\n  border:1px solid var(--border2);color:var(--text2);background:var(--bg3);\n}\n.chip.u1{border-color:rgba(34,211,238,.3);color:var(--cyan);}\n.chip.u2{border-color:rgba(129,140,248,.3);color:var(--accent);}\n.chip.u3{border-color:rgba(196,132,252,.3);color:var(--purple);}\n\n/* ── SECTIONS ── */\n.section{margin-bottom:64px;}\n.section-header{\n  display:flex;align-items:center;gap:12px;margin-bottom:28px;\n  padding-bottom:16px;border-bottom:1px solid var(--border);\n}\n.section-icon{font-size:22px;}\n.section-title{font-size:22px;font-weight:700;letter-spacing:-.3px;}\n.section-badge{\n  font-size:11px;padding:2px 10px;border-radius:20px;font-weight:600;\n}\n.badge-cyan{background:rgba(34,211,238,.12);color:var(--cyan);border:1px solid rgba(34,211,238,.25);}\n.badge-indigo{background:rgba(99,102,241,.12);color:var(--accent);border:1px solid rgba(99,102,241,.25);}\n.badge-purple{background:rgba(196,132,252,.12);color:var(--purple);border:1px solid rgba(196,132,252,.25);}\n.badge-amber{background:rgba(251,191,36,.12);color:var(--amber);border:1px solid rgba(251,191,36,.25);}\n.badge-green{background:rgba(74,222,128,.12);color:var(--green);border:1px solid rgba(74,222,128,.25);}\n\n/* ── CARDS ── */\n.card{\n  background:var(--bg3);border:1px solid var(--border);border-radius:10px;\n  padding:22px 24px;margin-bottom:16px;\n}\n.card:hover{border-color:var(--border2);}\n.card-title{\n  font-size:14px;font-weight:600;color:var(--accent);\n  margin-bottom:12px;display:flex;align-items:center;gap:8px;\n}\n\n/* ── DEFINITION BOX ── */\n.def-box{\n  border-left:3px solid var(--accent2);background:rgba(99,102,241,.07);\n  border-radius:0 8px 8px 0;padding:14px 18px;margin:12px 0;\n}\n.def-box.cyan{border-left-color:var(--cyan);background:rgba(34,211,238,.06);}\n.def-box.amber{border-left-color:var(--amber);background:rgba(251,191,36,.06);}\n.def-box.green{border-left-color:var(--green);background:rgba(74,222,128,.06);}\n.def-box.red{border-left-color:var(--red);background:rgba(248,113,113,.06);}\n.def-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:5px;}\n.def-box.cyan .def-label{color:var(--cyan);}\n.def-box.amber .def-label{color:var(--amber);}\n.def-box.green .def-label{color:var(--green);}\n.def-box.red .def-label{color:var(--red);}\n\n/* ── TABLES ── */\n.tbl-wrap{overflow-x:auto;margin:12px 0;border-radius:8px;border:1px solid var(--border);}\ntable{width:100%;border-collapse:collapse;font-size:13.5px;}\nthead tr{background:var(--bg4);}\nth{padding:10px 16px;text-align:left;font-weight:600;color:var(--text2);font-size:12px;letter-spacing:.04em;text-transform:uppercase;border-bottom:1px solid var(--border2);}\ntd{padding:9px 16px;border-bottom:1px solid var(--border);color:var(--text);}\ntr:last-child td{border-bottom:none;}\ntr:nth-child(even) td{background:rgba(255,255,255,.015);}\ntr:hover td{background:rgba(255,255,255,.03);}\n.td-acc{color:var(--green);font-weight:600;}\n.td-rej{color:var(--red);}\n.td-start{color:var(--amber);font-weight:600;}\n\n/* ── CODE ── */\npre,code{font-family:'JetBrains Mono','Fira Code','Cascadia Code',monospace;}\n.code-block{\n  background:#050810;border:1px solid var(--border);border-radius:8px;\n  padding:16px 20px;margin:12px 0;overflow-x:auto;\n  font-size:13px;line-height:1.8;color:#c9d1d9;\n}\ncode{background:rgba(255,255,255,.08);padding:2px 6px;border-radius:4px;font-size:13px;color:var(--cyan);}\n\n/* ── ALERT / NOTE ── */\n.alert{\n  display:flex;gap:12px;padding:14px 16px;border-radius:8px;margin:14px 0;\n  border:1px solid;font-size:14px;\n}\n.alert.tip{background:rgba(74,222,128,.06);border-color:rgba(74,222,128,.2);color:#c9f0d5;}\n.alert.warn{background:rgba(251,191,36,.06);border-color:rgba(251,191,36,.2);color:#fde8a0;}\n.alert.info{background:rgba(34,211,238,.06);border-color:rgba(34,211,238,.2);color:#a5f3fc;}\n.alert-icon{font-size:16px;margin-top:1px;flex-shrink:0;}\n\n/* ── GRID ── */\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:12px 0;}\n.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin:12px 0;}\n\n/* ── STAT CARDS ── */\n.stat-card{\n  background:var(--bg3);border:1px solid var(--border);border-radius:10px;\n  padding:18px;text-align:center;\n}\n.stat-num{font-size:28px;font-weight:800;color:var(--accent);}\n.stat-label{font-size:12px;color:var(--text3);margin-top:4px;}\n\n/* ── FORMULA ── */\n.formula{\n  font-family:monospace;background:var(--bg4);border:1px solid var(--border2);\n  border-radius:6px;padding:10px 16px;margin:8px 0;\n  font-size:14px;color:var(--amber);text-align:center;\n}\n\n/* ── SEPARATOR ── */\n.sep{border:none;border-top:1px solid var(--border);margin:32px 0;}\n\n/* ── SAMPLE PAPERS ── */\n.paper-tabs{display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap;}\n.paper-tab{\n  padding:8px 20px;border-radius:8px;cursor:pointer;font-size:13.5px;font-weight:500;\n  border:1px solid var(--border2);color:var(--text2);background:var(--bg3);transition:.15s;\n}\n.paper-tab:hover{border-color:var(--accent);color:var(--accent);}\n.paper-tab.active-tab{background:var(--active-bg);border-color:var(--accent2);color:var(--accent);}\n.paper-content{display:none;}\n.paper-content.show{display:block;}\n\n.q-card{\n  background:var(--bg3);border:1px solid var(--border);border-radius:10px;\n  margin-bottom:14px;overflow:hidden;\n}\n.q-header{\n  display:flex;align-items:center;gap:12px;padding:14px 20px;\n  background:var(--bg4);border-bottom:1px solid var(--border);cursor:pointer;\n}\n.q-num{\n  width:30px;height:30px;border-radius:50%;background:var(--bg5);\n  display:flex;align-items:center;justify-content:center;\n  font-size:13px;font-weight:700;color:var(--accent);flex-shrink:0;\n}\n.q-title{flex:1;font-size:14px;font-weight:500;color:var(--text);}\n.q-meta{display:flex;gap:8px;align-items:center;}\n.marks-badge{\n  font-size:11px;padding:2px 8px;border-radius:20px;font-weight:600;\n  background:rgba(251,191,36,.12);color:var(--amber);border:1px solid rgba(251,191,36,.25);\n}\n.co-badge{\n  font-size:11px;padding:2px 8px;border-radius:20px;font-weight:600;\n  background:rgba(34,211,238,.08);color:var(--cyan);border:1px solid rgba(34,211,238,.2);\n}\n.q-body{padding:20px;border-top:1px solid var(--border);}\n.q-ans{\n  margin-top:12px;padding:14px;background:rgba(74,222,128,.05);\n  border:1px solid rgba(74,222,128,.15);border-radius:8px;\n}\n.q-ans-label{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--green);margin-bottom:8px;letter-spacing:.06em;}\n.toggle-ans{\n  margin-top:10px;padding:6px 16px;font-size:12px;cursor:pointer;\n  background:transparent;border:1px solid var(--border2);border-radius:6px;color:var(--text3);\n  font-family:inherit;transition:.15s;\n}\n.toggle-ans:hover{border-color:var(--green);color:var(--green);}\n\n/* ── PYP ── */\n.pyp-q{\n  margin-bottom:20px;padding:20px;background:var(--bg3);\n  border:1px solid var(--border);border-radius:10px;\n}\n.pyp-q-header{\n  display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;\n}\n.pyp-q-num{\n  background:var(--accent2);color:white;\n  padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700;flex-shrink:0;\n}\n.pyp-q-text{font-size:14.5px;font-weight:500;}\n.pyp-ans{\n  margin-top:12px;padding:16px;background:var(--bg4);border-radius:8px;\n  border-left:3px solid var(--green);\n}\n.pyp-ans-label{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--green);margin-bottom:10px;}\n\nh2{font-size:18px;font-weight:700;margin:20px 0 10px;color:var(--text);}\nh3{font-size:15px;font-weight:600;margin:16px 0 8px;color:var(--text2);}\np{margin:8px 0;color:var(--text2);}\nul,ol{padding-left:20px;margin:8px 0;}\nli{margin:4px 0;color:var(--text2);}\nstrong{color:var(--text);font-weight:600;}\nem{color:var(--amber);font-style:normal;}\n\n/* ── SCROLLBAR ── */\n.main::-webkit-scrollbar{width:6px;}\n.main::-webkit-scrollbar-track{background:var(--bg);}\n.main::-webkit-scrollbar-thumb{background:var(--bg5);border-radius:3px;}\n\n/* ── RESPONSIVE ── */\n@media(max-width:900px){\n  .sidebar{width:220px;min-width:220px;}\n  .content{padding:32px 24px 60px;}\n  .grid2{grid-template-columns:1fr;}\n  .hero{padding:28px;}\n}\n@media(max-width:640px){\n  body{flex-direction:column;}\n  .sidebar{width:100%;height:auto;position:static;border-right:none;border-bottom:1px solid var(--border);}\n  .nav{display:none;}\n  .content{padding:24px 16px 60px;}\n  .hero h1{font-size:26px;}\n}\n@media print{\n  .sidebar,.topbar{display:none;}\n  .main{background:white;color:black;}\n  .section:not(#papers-section){display:none;}\n}\n\n/* ── MISC ── */\n.highlight{color:var(--accent);}\n.mono{font-family:monospace;font-size:13px;}\n.mt4{margin-top:4px;}\n.mt8{margin-top:8px;}\n.mt16{margin-top:16px;}\n.mb4{margin-bottom:4px;}\n.two-col{display:flex;gap:24px;flex-wrap:wrap;}\n.two-col > *{flex:1;min-width:240px;}\n.tag{\n  display:inline-block;font-size:11px;padding:2px 8px;border-radius:4px;\n  margin-right:4px;font-weight:500;\n}\n.tag-cyan{background:rgba(34,211,238,.12);color:var(--cyan);}\n.tag-purple{background:rgba(196,132,252,.12);color:var(--purple);}\n.tag-green{background:rgba(74,222,128,.12);color:var(--green);}\n</style>\n</head>\n<body>\n\n<!-- ═══════════════ SIDEBAR ═══════════════ -->\n<nav class=\"sidebar\">\n  <div class=\"logo\">\n    <div class=\"logo-icon\">⚛</div>\n    <div>\n      <div class=\"logo-text\">TOC Study Hub</div>\n      <div class=\"logo-sub\">Theory of Computation · Sem 3</div>\n    </div>\n  </div>\n  <div class=\"nav\">\n    <div class=\"nav-group\">\n      <div class=\"nav-group-title\">Overview</div>\n      <a href=\"#home\" class=\"nav-item active\" onclick=\"setActive(this)\">\n        <span class=\"icon\">🏠</span>Home\n      </a>\n    </div>\n\n    <div class=\"nav-group\">\n      <div class=\"nav-group-title\">Unit 1 — Introduction</div>\n      <a href=\"#u1-toc\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">📐</span>Branches of ToC\n      </a>\n      <a href=\"#u1-strings\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">🔤</span>Alphabets & Strings\n      </a>\n      <a href=\"#u1-langs\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">🌐</span>Language Operations\n      </a>\n      <a href=\"#u1-math\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">📏</span>Math Prerequisites\n      </a>\n    </div>\n\n    <div class=\"nav-group\">\n      <div class=\"nav-group-title\">Unit 2 — Finite Automata</div>\n      <a href=\"#u2-dfa\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">🤖</span>DFA\n      </a>\n      <a href=\"#u2-nfa\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">🔀</span>NFA & ε-NFA\n      </a>\n      <a href=\"#u2-convert\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">🔄</span>NFA → DFA Conversion\n      </a>\n      <a href=\"#u2-min\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">📦</span>DFA Minimization\n      </a>\n      <a href=\"#u2-mealy\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">⚙️</span>Moore & Mealy\n      </a>\n      <a href=\"#u2-closure\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">🔒</span>Closure Properties\n      </a>\n    </div>\n\n    <div class=\"nav-group\">\n      <div class=\"nav-group-title\">Unit 3 — Regular Expr.</div>\n      <a href=\"#u3-def\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">✨</span>RE Definition\n      </a>\n      <a href=\"#u3-examples\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">📋</span>RE Examples\n      </a>\n      <a href=\"#u3-equiv\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">⚖️</span>RE Equivalence\n      </a>\n      <a href=\"#u3-fa\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">↔️</span>RE ↔ Automata\n      </a>\n    </div>\n\n    <div class=\"nav-group\">\n      <div class=\"nav-group-title\">Previous Year Paper</div>\n      <a href=\"#pyp\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">📄</span>T1 — All Solutions\n      </a>\n    </div>\n\n    <div class=\"nav-group\">\n      <div class=\"nav-group-title\">Sample Papers</div>\n      <a href=\"#papers\" class=\"nav-item\" onclick=\"setActive(this)\">\n        <span class=\"icon\">📝</span>4 × 6 Question Papers\n      </a>\n    </div>\n  </div>\n</nav>\n\n<!-- ═══════════════ MAIN ═══════════════ -->\n<div class=\"main\">\n  <div class=\"topbar\">\n    <div class=\"topbar-title\">TOC · Test 1 Prep · Units 1, 2, 3</div>\n    <div class=\"topbar-badge\">14 Marks Per Paper</div>\n  </div>\n\n  <div class=\"content\">\n\n    <!-- ═══ HOME ═══ -->\n    <div id=\"home\" class=\"section\">\n      <div class=\"hero\">\n        <div class=\"hero-tag\">📚 Exam Ready</div>\n        <h1>Theory of Computation</h1>\n        <p>Complete notes, previous year solutions, and 4 practice papers for Test 1. Covers Units 1–3 from your class lecture slides.</p>\n        <div class=\"hero-chips\">\n          <span class=\"chip u1\">Unit 1 · Introduction</span>\n          <span class=\"chip u2\">Unit 2 · Finite Automata</span>\n          <span class=\"chip u3\">Unit 3 · Regular Expr.</span>\n          <span class=\"chip\">PYP T1 Solutions</span>\n          <span class=\"chip\">4 Sample Papers</span>\n        </div>\n      </div>\n      <div class=\"grid3\">\n        <div class=\"stat-card\"><div class=\"stat-num\" style=\"color:var(--cyan)\">3</div><div class=\"stat-label\">Units Covered</div></div>\n        <div class=\"stat-card\"><div class=\"stat-num\" style=\"color:var(--accent)\">6</div><div class=\"stat-label\">Questions in PYP</div></div>\n        <div class=\"stat-card\"><div class=\"stat-num\" style=\"color:var(--amber)\">24</div><div class=\"stat-label\">Sample Questions</div></div>\n      </div>\n      <div class=\"alert tip mt16\"><div class=\"alert-icon\">💡</div><div>The <strong>PYP T1</strong> typically follows: Q1(1M) + Q1b(1M) + Q2(2M) + Q3(2M) + Q4(2M) + Q5(4M) + Q6(4M) = <strong>16 marks</strong>. Focus on DFA construction, NFA→DFA, and minimization.</div></div>\n    </div>\n\n    <!-- ═══ UNIT 1 — TOC ═══ -->\n    <div id=\"u1-toc\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">📐</div>\n        <div class=\"section-title\">Branches of Theory of Computation</div>\n        <span class=\"section-badge badge-cyan\">Unit 1</span>\n      </div>\n\n      <div class=\"tbl-wrap\">\n        <table>\n          <thead><tr><th>Branch</th><th>Concerned With</th><th>Tools</th></tr></thead>\n          <tbody>\n            <tr><td><strong>Automata Theory</strong></td><td>Modeling machines & recognizing languages</td><td>DFA, NFA, PDA, TM</td></tr>\n            <tr><td><strong>Computability Theory</strong></td><td>What <em>can</em> be computed?</td><td>Recursive functions, Turing Machines</td></tr>\n            <tr><td><strong>Complexity Theory</strong></td><td>How <em>efficiently</em> can it be done?</td><td>Time/space complexity, P vs NP</td></tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-title\">🏗️ Automata Hierarchy (Chomsky)</div>\n        <div class=\"code-block\">Finite Automata          → Regular Languages\nPushdown Automata (PDA)  → Context-Free Languages\nLinear Bounded Automata  → Context-Sensitive Languages\nTuring Machine           → Recursively Enumerable Languages\n\nLess powerful ─────────────────────────────► More powerful\n(FA)                                         (TM)</div>\n      </div>\n\n      <div class=\"alert info\"><div class=\"alert-icon\">ℹ️</div><div><strong>Undecidable Problems (not computable):</strong> Halting Problem, Integer equation solvability (Hilbert's 10th), Post Correspondence Problem.</div></div>\n    </div>\n\n    <!-- ═══ UNIT 1 — STRINGS ═══ -->\n    <div id=\"u1-strings\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">🔤</div>\n        <div class=\"section-title\">Alphabets, Strings & Special Sets</div>\n        <span class=\"section-badge badge-cyan\">Unit 1</span>\n      </div>\n\n      <div class=\"def-box cyan\">\n        <div class=\"def-label\">Alphabet (Σ)</div>\n        A <strong>finite</strong> set of symbols. e.g., Σ = {0,1} (binary), Σ = {a,b,…,z} (lowercase)\n      </div>\n      <div class=\"def-box\">\n        <div class=\"def-label\">String</div>\n        A <strong>finite</strong> sequence of symbols from Σ. The <em>empty string</em> is ε (also λ) with |ε| = 0.\n      </div>\n\n      <div class=\"grid2 mt8\">\n        <div class=\"card\">\n          <div class=\"card-title\">📏 String Operations</div>\n          <div class=\"tbl-wrap\">\n            <table>\n              <thead><tr><th>Operation</th><th>Definition / Example</th></tr></thead>\n              <tbody>\n                <tr><td><strong>Length</strong> |w|</td><td>|aab| = 3, |ε| = 0</td></tr>\n                <tr><td><strong>Concatenation</strong></td><td>ω=abd, α=ce → ωα=abdce</td></tr>\n                <tr><td><strong>Exponentiation</strong></td><td>ω³=abdabdabd, ω⁰=ε</td></tr>\n                <tr><td><strong>Reversal</strong> wᴿ</td><td>ω=abd → ωᴿ=dba</td></tr>\n                <tr><td><strong>Σᵏ</strong></td><td>All strings of exactly length k</td></tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-title\">♾️ Special String Sets</div>\n          <div class=\"def-box amber\">\n            <div class=\"def-label\">Kleene Closure Σ*</div>\n            Σ* = Σ⁰ ∪ Σ¹ ∪ Σ² ∪ … = all strings over Σ (including ε)<br>\n            e.g., {a,b}* = {ε, a, b, aa, ab, ba, bb, …}\n          </div>\n          <div class=\"def-box green\">\n            <div class=\"def-label\">Positive Closure Σ⁺</div>\n            Σ⁺ = Σ* − {ε} = all non-empty strings<br>\n            Σ⁺ = Σ¹ ∪ Σ² ∪ Σ³ ∪ …\n          </div>\n          <p class=\"mt8\"><code>|Σᵏ| = |Σ|ᵏ</code>&nbsp;&nbsp;|2ˢ| = 2^|ˢ| (powerset size)</p>\n        </div>\n      </div>\n\n      <div class=\"alert warn\"><div class=\"alert-icon\">⚠️</div><div><strong>Common Trap:</strong> Σ⁰ = {ε} (contains the empty string), NOT ∅. Also, ∅* = {ε} (Kleene star of empty language = language with just ε).</div></div>\n    </div>\n\n    <!-- ═══ UNIT 1 — LANGUAGE OPS ═══ -->\n    <div id=\"u1-langs\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">🌐</div>\n        <div class=\"section-title\">Languages & Operations</div>\n        <span class=\"section-badge badge-cyan\">Unit 1</span>\n      </div>\n      <div class=\"def-box cyan\">\n        <div class=\"def-label\">Formal Language</div>\n        Any subset L ⊆ Σ*. Can be finite or infinite. A \"problem\" in automata = deciding if a string ∈ L.\n      </div>\n      <div class=\"tbl-wrap mt8\">\n        <table>\n          <thead><tr><th>Operation</th><th>Definition</th></tr></thead>\n          <tbody>\n            <tr><td><strong>Union</strong></td><td>L₁ ∪ L₂ = {x | x ∈ L₁ or x ∈ L₂}</td></tr>\n            <tr><td><strong>Intersection</strong></td><td>L₁ ∩ L₂ = {x | x ∈ L₁ and x ∈ L₂}</td></tr>\n            <tr><td><strong>Difference</strong></td><td>L₁ − L₂ = {x | x ∈ L₁ and x ∉ L₂}</td></tr>\n            <tr><td><strong>Complement</strong></td><td>L̄ = Σ* − L</td></tr>\n            <tr><td><strong>Concatenation</strong></td><td>L₁L₂ = {xy | x ∈ L₁, y ∈ L₂}</td></tr>\n            <tr><td><strong>Kleene Star L*</strong></td><td>L⁰ ∪ L¹ ∪ L² ∪ … (zero or more concats)</td></tr>\n            <tr><td><strong>Positive L⁺</strong></td><td>L¹ ∪ L² ∪ … = L* − {ε}</td></tr>\n            <tr><td><strong>Reverse Lᴿ</strong></td><td>{wᴿ | w ∈ L}</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 1 — MATH ═══ -->\n    <div id=\"u1-math\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">📏</div>\n        <div class=\"section-title\">Mathematical Prerequisites</div>\n        <span class=\"section-badge badge-cyan\">Unit 1</span>\n      </div>\n      <div class=\"grid2\">\n        <div class=\"card\">\n          <div class=\"card-title\">🔢 Sets</div>\n          <ul>\n            <li>Powerset of S: 2ˢ = all subsets; |2ˢ| = 2^|S|</li>\n            <li>|A| = n → number of relations on A = 2^(n²)</li>\n            <li>Complement: Ā = U − A</li>\n          </ul>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-title\">🔗 Relations</div>\n          <ul>\n            <li>Binary relation R ⊆ A × B</li>\n            <li><strong>Inverse:</strong> R⁻¹ = {(b,a) | (a,b) ∈ R}</li>\n            <li><strong>Composition:</strong> S ◦ R — if (a,b)∈R and (b,c)∈S → (a,c)∈S◦R</li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"card mt8\">\n        <div class=\"card-title\">📊 Mathematical Induction</div>\n        <div class=\"two-col\">\n          <div>\n            <strong>Basis Step:</strong> Prove P(1) (or P(base case) is true)<br>\n            <strong>Inductive Step:</strong> Assume P(k) → Prove P(k+1)<br><br>\n            <em>Other techniques:</em> Proof by Contradiction, Contrapositive, Counter-example\n          </div>\n          <div class=\"def-box amber\">\n            <div class=\"def-label\">Structural Induction</div>\n            For recursively defined sets (like Σ*). Prove base case, then show inductive step using the recursive definition.\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <hr class=\"sep\">\n\n    <!-- ═══ UNIT 2 — DFA ═══ -->\n    <div id=\"u2-dfa\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">🤖</div>\n        <div class=\"section-title\">Deterministic Finite Automata (DFA)</div>\n        <span class=\"section-badge badge-indigo\">Unit 2</span>\n      </div>\n\n      <div class=\"def-box\">\n        <div class=\"def-label\">Formal Definition — DFA</div>\n        A DFA M = (Q, Σ, δ, q₀, F) where:<br>\n        &nbsp;&nbsp;<strong>Q</strong> — finite set of states<br>\n        &nbsp;&nbsp;<strong>Σ</strong> — finite input alphabet<br>\n        &nbsp;&nbsp;<strong>δ : Q × Σ → Q</strong> — transition function (total function; exactly one next state)<br>\n        &nbsp;&nbsp;<strong>q₀ ∈ Q</strong> — start state<br>\n        &nbsp;&nbsp;<strong>F ⊆ Q</strong> — set of final/accepting states\n      </div>\n\n      <div class=\"def-box amber\">\n        <div class=\"def-label\">Extended Transition Function δ̂</div>\n        δ̂(q, ε) = q<br>\n        δ̂(q, wa) = δ(δ̂(q, w), a)&nbsp;&nbsp;— state after reading entire string w from state q<br>\n        <strong>Language:</strong> L(M) = {w ∈ Σ* | δ̂(q₀, w) ∈ F}\n      </div>\n\n      <h2>Design Examples</h2>\n      <div class=\"grid2\">\n        <div class=\"card\">\n          <div class=\"card-title\">Even # of 0s over {0,1}</div>\n          <div class=\"tbl-wrap\">\n            <table><thead><tr><th>State</th><th>0</th><th>1</th><th>Accept?</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">→ q₀</span></td><td>q₁</td><td>q₀</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>q₁</td><td>q₀</td><td>q₁</td><td></td></tr>\n            </tbody></table>\n          </div>\n          <p class=\"mt4\" style=\"font-size:13px;color:var(--text3)\">q₀ = even 0s (accept), q₁ = odd 0s</p>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-title\">Strings containing \"aa\" over {a,b}</div>\n          <div class=\"tbl-wrap\">\n            <table><thead><tr><th>State</th><th>a</th><th>b</th><th>Accept?</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">→ q₀</span></td><td>q₁</td><td>q₀</td><td></td></tr>\n              <tr><td>q₁</td><td>q₂</td><td>q₀</td><td></td></tr>\n              <tr><td>q₂</td><td>q₂</td><td>q₂</td><td class=\"td-acc\">✓</td></tr>\n            </tbody></table>\n          </div>\n          <p class=\"mt4\" style=\"font-size:13px;color:var(--text3)\">q₂ = sink/absorbing accept state</p>\n        </div>\n      </div>\n\n      <div class=\"alert tip\"><div class=\"alert-icon\">💡</div><div>A DFA partitions Σ* into exactly two sets: L(M) (accepted) and Σ*−L(M) (rejected). Each state has <strong>exactly one</strong> transition per symbol.</div></div>\n    </div>\n\n    <!-- ═══ UNIT 2 — NFA ═══ -->\n    <div id=\"u2-nfa\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">🔀</div>\n        <div class=\"section-title\">NFA & ε-NFA</div>\n        <span class=\"section-badge badge-indigo\">Unit 2</span>\n      </div>\n\n      <div class=\"def-box\">\n        <div class=\"def-label\">NFA — Key Differences from DFA</div>\n        δ : Q × Σ → <strong>2^Q</strong> (returns a SET of states, possibly empty)<br>\n        • A state can have 0, 1, or more transitions on the same symbol<br>\n        • String is <strong>accepted</strong> if at least one computation path reaches a final state\n      </div>\n\n      <div class=\"tbl-wrap mt8\">\n        <table>\n          <thead><tr><th>Feature</th><th>DFA</th><th>NFA</th></tr></thead>\n          <tbody>\n            <tr><td>Transition per symbol</td><td>Exactly 1</td><td>0, 1, or many</td></tr>\n            <tr><td>δ type</td><td>Q × Σ → Q</td><td>Q × Σ → 2^Q</td></tr>\n            <tr><td>ε-moves</td><td>❌</td><td>✅ (in ε-NFA)</td></tr>\n            <tr><td>Accept condition</td><td>One path must accept</td><td>Any one path accepts</td></tr>\n            <tr><td>Power</td><td colspan=\"2\" style=\"color:var(--green)\">Equivalent! NFA = DFA for regular languages</td></tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"def-box cyan\">\n        <div class=\"def-label\">ε-closure (for ε-NFA)</div>\n        ε-closure(q) = set of states reachable from q using only ε-transitions (including q itself).<br>\n        ε-closure({q₁,q₂,...}) = ε-closure(q₁) ∪ ε-closure(q₂) ∪ …\n      </div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">📝 NFA Example: 3rd symbol from right = 'a'</div>\n        <div class=\"tbl-wrap\">\n          <table><thead><tr><th>State</th><th>a</th><th>b</th><th>Accept?</th></tr></thead>\n          <tbody>\n            <tr><td><span class=\"td-start\">→ q₀</span></td><td>{q₀, q₁}</td><td>{q₀}</td><td></td></tr>\n            <tr><td>q₁</td><td>{q₂}</td><td>{q₂}</td><td></td></tr>\n            <tr><td>q₂</td><td>{q₃}</td><td>{q₃}</td><td></td></tr>\n            <tr><td>q₃</td><td>∅</td><td>∅</td><td class=\"td-acc\">✓</td></tr>\n          </tbody></table>\n        </div>\n        <p class=\"mt8\" style=\"font-size:13px\">q₀ non-deterministically guesses when 3rd-from-last 'a' is read, then tracks the next 2 symbols.</p>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 2 — CONVERT ═══ -->\n    <div id=\"u2-convert\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">🔄</div>\n        <div class=\"section-title\">NFA → DFA (Subset Construction)</div>\n        <span class=\"section-badge badge-indigo\">Unit 2</span>\n      </div>\n\n      <div class=\"def-box\">\n        <div class=\"def-label\">Algorithm — Subset Construction</div>\n        Given NFA M = (Q, Σ, δ, q₀, F), build DFA N = (Q', Σ, δ', q₀', F'):<br><br>\n        • <strong>Q'</strong> = 2^Q (all subsets of Q)<br>\n        • <strong>q₀'</strong> = ε-closure({q₀})<br>\n        • <strong>F'</strong> = all sets in Q' containing at least one state from F<br>\n        • <strong>δ'(S, a)</strong> = ε-closure(⋃{δ(q,a) | q ∈ S})\n      </div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">📋 Step-by-Step Algorithm</div>\n        <ol>\n          <li>Compute start state = ε-closure({q₀})</li>\n          <li>For each unprocessed DFA state (NFA state set) S and each input symbol a:<br>&nbsp;&nbsp;&nbsp;– Compute raw states = ⋃{δ(q,a) | q ∈ S}<br>&nbsp;&nbsp;&nbsp;– Apply ε-closure to get new DFA state</li>\n          <li>Empty set ∅ → dead/trap state (non-accepting, self-loops on all symbols)</li>\n          <li>Mark any DFA state containing an NFA accept state as accepting</li>\n        </ol>\n      </div>\n\n      <div class=\"alert warn\"><div class=\"alert-icon\">⚠️</div><div>In the worst case, NFA with n states → DFA with 2ⁿ states. But typically far fewer states are <em>reachable</em>. Always start from the initial state and only add reachable states.</div></div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">📊 Quick Reference: ε-NFA to DFA (PYP Q5)</div>\n        <div class=\"tbl-wrap\">\n          <table>\n            <thead><tr><th>DFA State</th><th>NFA States</th><th>On 0</th><th>On 1</th><th>Accept?</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">A</span></td><td>{q₀,q₁,q₂}</td><td>B</td><td>C</td><td></td></tr>\n              <tr><td>B</td><td>{q₁,q₂,q₃}</td><td>D</td><td>C</td><td></td></tr>\n              <tr><td>C</td><td>{q₁,q₂,q₄}</td><td>B</td><td>E</td><td></td></tr>\n              <tr><td>D</td><td>{q₁,q₂,q₃,q₅,q₆,q₇}</td><td>D</td><td>F</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>E</td><td>{q₁,q₂,q₄,q₅,q₆,q₇}</td><td>G</td><td>E</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>F</td><td>{q₁,q₂,q₄,q₆,q₇}</td><td>G</td><td>E</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>G</td><td>{q₁,q₂,q₃,q₆,q₇}</td><td>D</td><td>F</td><td class=\"td-acc\">✓</td></tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"mt8\" style=\"font-size:13px;color:var(--text3)\">Language: (0+1)*(00+11)(0+1)* — strings containing \"00\" or \"11\"</p>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 2 — MINIMIZATION ═══ -->\n    <div id=\"u2-min\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">📦</div>\n        <div class=\"section-title\">DFA Minimization (Mark Algorithm)</div>\n        <span class=\"section-badge badge-indigo\">Unit 2</span>\n      </div>\n\n      <div class=\"def-box\">\n        <div class=\"def-label\">Distinguishable States</div>\n        States p and q are <strong>distinguishable</strong> by string w if exactly one of δ̂(p,w), δ̂(q,w) is in F.<br>\n        States p and q are <strong>indistinguishable</strong> (≡) if for ALL w: δ̂(p,w)∈F iff δ̂(q,w)∈F.\n      </div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">📋 Mark (Table-Filling) Procedure</div>\n        <ol>\n          <li><strong>Remove inaccessible states</strong> (unreachable from q₀)</li>\n          <li><strong>Base marking:</strong> Mark pair (p,q) if one ∈ F and other ∉ F</li>\n          <li><strong>Iterate:</strong> For all pairs (p,q) and all a ∈ Σ:<br>&nbsp;&nbsp;&nbsp;If (δ(p,a), δ(q,a)) is marked → mark (p,q) too</li>\n          <li>Repeat step 3 until no new pairs are marked</li>\n          <li><strong>Unmarked pairs</strong> = indistinguishable states → merge them</li>\n        </ol>\n      </div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">📊 PYP Q5 — DFA Minimization Worked Example</div>\n        <p style=\"margin-bottom:12px\">Original 6-state DFA (A=start, E&F=accept):</p>\n        <div class=\"tbl-wrap\">\n          <table><thead><tr><th>State</th><th>0</th><th>1</th><th>Accept?</th></tr></thead>\n          <tbody>\n            <tr><td><span class=\"td-start\">→ A</span></td><td>B</td><td>D</td><td></td></tr>\n            <tr><td>B</td><td>B</td><td>C</td><td></td></tr>\n            <tr><td>C</td><td>E</td><td>F</td><td></td></tr>\n            <tr><td>D</td><td>E</td><td>F</td><td></td></tr>\n            <tr><td>E</td><td>E</td><td>F</td><td class=\"td-acc\">✓</td></tr>\n            <tr><td>F</td><td>F</td><td>F</td><td class=\"td-acc\">✓</td></tr>\n          </tbody></table>\n        </div>\n        <div class=\"def-box green mt8\">\n          <div class=\"def-label\">Result: 3 Equivalence Classes</div>\n          <strong>{A, B}</strong> — Both non-accepting, same transitions to same classes<br>\n          <strong>{C, D}</strong> — Both non-accepting; C:0→E,1→F ≡ D:0→E,1→F (identical!)<br>\n          <strong>{E, F}</strong> — Both accepting; all transitions stay in {E,F}\n        </div>\n        <div class=\"tbl-wrap mt8\">\n          <table><thead><tr><th>Min. State</th><th>0</th><th>1</th><th>Accept?</th></tr></thead>\n          <tbody>\n            <tr><td><span class=\"td-start\">→ P={A,B}</span></td><td>P</td><td>Q</td><td></td></tr>\n            <tr><td>Q={C,D}</td><td>R</td><td>R</td><td></td></tr>\n            <tr><td>R={E,F}</td><td>R</td><td>R</td><td class=\"td-acc\">✓</td></tr>\n          </tbody></table>\n        </div>\n        <p class=\"mt8\" style=\"font-size:13px;color:var(--green)\">✅ 6 states → 3 states</p>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 2 — MOORE/MEALY ═══ -->\n    <div id=\"u2-mealy\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">⚙️</div>\n        <div class=\"section-title\">Moore & Mealy Machines</div>\n        <span class=\"section-badge badge-indigo\">Unit 2</span>\n      </div>\n\n      <div class=\"tbl-wrap\">\n        <table>\n          <thead><tr><th>Feature</th><th>Moore Machine</th><th>Mealy Machine</th></tr></thead>\n          <tbody>\n            <tr><td><strong>Output depends on</strong></td><td>State only</td><td>State + Input</td></tr>\n            <tr><td><strong>Output function λ</strong></td><td>λ: Q → Δ</td><td>λ: Q × Σ → Δ</td></tr>\n            <tr><td><strong>Output per step</strong></td><td>On entering a state</td><td>On each transition</td></tr>\n            <tr><td><strong>Output length</strong></td><td>|w| + 1</td><td>|w|</td></tr>\n            <tr><td><strong>Diagram label</strong></td><td>State labeled: state/output</td><td>Arc labeled: input/output</td></tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"grid2 mt8\">\n        <div class=\"card\">\n          <div class=\"card-title\">🔄 Mealy → Moore Conversion</div>\n          <ol>\n            <li>Identify <strong>incoming output</strong> for each state</li>\n            <li>If a state q receives multiple different outputs → <strong>split it</strong> into q_o₁, q_o₂, … (one per distinct output)</li>\n            <li>Each new state gets output = the output that arrives with it</li>\n            <li>Redirect transitions to the appropriate split state</li>\n          </ol>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-title\">🔄 Moore → Mealy Conversion</div>\n          <ol>\n            <li>For each transition δ(p, a) = q</li>\n            <li>In Mealy: label the arc <code>a / λ(q)</code><br>(output of the destination state)</li>\n            <li>Remove state output labels</li>\n            <li>Same number of states, just move output from states to arcs</li>\n          </ol>\n        </div>\n      </div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">📊 PYP Q6a — Mealy Machine (output A/B/C)</div>\n        <p style=\"margin-bottom:10px;font-size:13px\">Output <em>A</em> if ends with \"10\", <em>B</em> if ends with \"11\", <em>C</em> otherwise</p>\n        <div class=\"tbl-wrap\">\n          <table><thead><tr><th>State</th><th>Input</th><th>Output</th><th>Next State</th></tr></thead>\n          <tbody>\n            <tr><td><span class=\"td-start\">→ q₀ (last='0'/start)</span></td><td>0</td><td>C</td><td>q₀</td></tr>\n            <tr><td><span class=\"td-start\">→ q₀</span></td><td>1</td><td>C</td><td>q₁</td></tr>\n            <tr><td>q₁ (last='1')</td><td>0</td><td style=\"color:var(--amber)\">A</td><td>q₀</td></tr>\n            <tr><td>q₁ (last='1')</td><td>1</td><td style=\"color:var(--green)\">B</td><td>q₁</td></tr>\n          </tbody></table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 2 — CLOSURE ═══ -->\n    <div id=\"u2-closure\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">🔒</div>\n        <div class=\"section-title\">Closure Properties of Regular Languages</div>\n        <span class=\"section-badge badge-indigo\">Unit 2</span>\n      </div>\n\n      <div class=\"def-box green\">\n        <div class=\"def-label\">Closure</div>\n        A class L is <strong>closed</strong> under operation op if: L₁, L₂ ∈ L → op(L₁, L₂) ∈ L.\n      </div>\n\n      <div class=\"tbl-wrap mt8\">\n        <table>\n          <thead><tr><th>Operation</th><th>Regular? (closed?)</th><th>Proof Method</th></tr></thead>\n          <tbody>\n            <tr><td>Union L₁∪L₂</td><td class=\"td-acc\">✓ YES</td><td>RE: R₁+R₂; or NFA construction</td></tr>\n            <tr><td>Concatenation L₁·L₂</td><td class=\"td-acc\">✓ YES</td><td>RE: R₁R₂</td></tr>\n            <tr><td>Kleene Star L*</td><td class=\"td-acc\">✓ YES</td><td>RE: R*</td></tr>\n            <tr><td>Complement L̄</td><td class=\"td-acc\">✓ YES</td><td>DFA: swap accepting ↔ non-accepting states</td></tr>\n            <tr><td>Intersection L₁∩L₂</td><td class=\"td-acc\">✓ YES</td><td>L̄₁∪L̄₂; or cross-product DFA</td></tr>\n            <tr><td>Difference L₁−L₂</td><td class=\"td-acc\">✓ YES</td><td>L₁ ∩ L̄₂</td></tr>\n            <tr><td>Reverse Lᴿ</td><td class=\"td-acc\">✓ YES</td><td>Reverse DFA transitions</td></tr>\n            <tr><td>Homomorphism h(L)</td><td class=\"td-acc\">✓ YES</td><td>Apply h to RE</td></tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">⚡ Cross-Product Construction (Intersection)</div>\n        <p>Given DFAs M₁=(Q₁,Σ,δ₁,q₁,F₁) and M₂=(Q₂,Σ,δ₂,q₂,F₂):</p>\n        <ul class=\"mt8\">\n          <li>Q = Q₁ × Q₂ (pairs of states)</li>\n          <li>q₀ = (q₁, q₂)</li>\n          <li>δ((p₁,p₂), a) = (δ₁(p₁,a), δ₂(p₂,a))</li>\n          <li>F = F₁ × F₂ (both states must be accepting)</li>\n        </ul>\n        <div class=\"alert tip mt8\"><div class=\"alert-icon\">💡</div><div>For <strong>union</strong>, use F = (F₁×Q₂) ∪ (Q₁×F₂) — at least one accepting.</div></div>\n      </div>\n    </div>\n\n    <hr class=\"sep\">\n\n    <!-- ═══ UNIT 3 — RE DEF ═══ -->\n    <div id=\"u3-def\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">✨</div>\n        <div class=\"section-title\">Regular Expressions — Definition</div>\n        <span class=\"section-badge badge-purple\">Unit 3</span>\n      </div>\n\n      <div class=\"grid2\">\n        <div>\n          <div class=\"def-box\">\n            <div class=\"def-label\">Base Cases</div>\n            <strong>∅</strong> — RE for empty language {}<br>\n            <strong>ε</strong> — RE for language {ε}<br>\n            <strong>a</strong> (∀a∈Σ) — RE for language {a}\n          </div>\n          <div class=\"def-box amber mt8\">\n            <div class=\"def-label\">Inductive Cases</div>\n            If E₁, E₂ are REs:<br>\n            • <strong>E₁ + E₂</strong> (union): L(E₁)∪L(E₂)<br>\n            • <strong>E₁E₂</strong> (concat): L(E₁)·L(E₂)<br>\n            • <strong>E*</strong> (Kleene star): (L(E))*\n          </div>\n        </div>\n        <div>\n          <div class=\"card\">\n            <div class=\"card-title\">📊 Operator Precedence (High → Low)</div>\n            <div class=\"formula\">* (star) &gt; concatenation &gt; + (union)</div>\n            <p>Parentheses override all. So <code>ab+c</code> = <code>(ab)+c</code>, not <code>a(b+c)</code></p>\n            <div class=\"def-box green mt8\">\n              <div class=\"def-label\">Shorthand Notations</div>\n              <strong>R⁺</strong> = RR* (one or more)<br>\n              <strong>R?</strong> = ε+R (zero or one)<br>\n              <strong>Rⁿ</strong> = R concatenated n times\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 3 — RE EXAMPLES ═══ -->\n    <div id=\"u3-examples\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">📋</div>\n        <div class=\"section-title\">Regular Expression Examples</div>\n        <span class=\"section-badge badge-purple\">Unit 3</span>\n      </div>\n\n      <div class=\"tbl-wrap\">\n        <table>\n          <thead><tr><th>Regular Expression</th><th>Language Described</th></tr></thead>\n          <tbody>\n            <tr><td><code>01*</code></td><td>{0, 01, 011, 0111, …}</td></tr>\n            <tr><td><code>(0+1)*</code></td><td>All binary strings (including ε)</td></tr>\n            <tr><td><code>(0+1)*00(0+1)*</code></td><td>All strings containing \"00\"</td></tr>\n            <tr><td><code>(0+1)*011</code></td><td>All strings ending with \"011\"</td></tr>\n            <tr><td><code>0*1*</code></td><td>Strings with all 0s before all 1s</td></tr>\n            <tr><td><code>00*11*</code></td><td>At least one 0 followed by at least one 1, no 0 after 1</td></tr>\n            <tr><td><code>(1+10)*</code></td><td>Strings starting with 1, no \"00\"</td></tr>\n            <tr><td><code>(0+1)*1(0+1)(0+1)</code></td><td>3rd symbol from right is 1</td></tr>\n            <tr><td><code>(1*01*01*01*)*</code></td><td>Number of 0s is multiple of 3</td></tr>\n            <tr><td><code>a*</code></td><td>All combinations of a's (incl. ε)</td></tr>\n            <tr><td><code>a+</code></td><td>All combinations of a's (excl. ε)</td></tr>\n            <tr><td><code>(a+b)*</code></td><td>All strings over {a,b}</td></tr>\n            <tr><td><code>(0+1)*00</code></td><td>Strings ending with \"00\"</td></tr>\n            <tr><td><code>1(0+1)*0</code></td><td>Starts with 1, ends with 0</td></tr>\n            <tr><td><code>(0+1)*(00+11)(0+1)*</code></td><td>Contains \"00\" or \"11\" as substring</td></tr>\n            <tr><td><code>a+b+c+</code></td><td>At least one a, then at least one b, then at least one c</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 3 — EQUIV ═══ -->\n    <div id=\"u3-equiv\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">⚖️</div>\n        <div class=\"section-title\">Equivalence of Regular Expressions</div>\n        <span class=\"section-badge badge-purple\">Unit 3</span>\n      </div>\n\n      <div class=\"def-box\">\n        <div class=\"def-label\">Equivalent REs</div>\n        R₁ ≡ R₂ if and only if <strong>L(R₁) = L(R₂)</strong>\n      </div>\n\n      <div class=\"tbl-wrap mt8\">\n        <table>\n          <thead><tr><th>Identity</th><th>Rule</th></tr></thead>\n          <tbody>\n            <tr><td><code>R + ∅ = R</code></td><td>∅ is identity for union</td></tr>\n            <tr><td><code>Rε = εR = R</code></td><td>ε is identity for concatenation</td></tr>\n            <tr><td><code>R∅ = ∅R = ∅</code></td><td>∅ annihilates concatenation</td></tr>\n            <tr><td><code>R** = R*</code></td><td>Star is idempotent</td></tr>\n            <tr><td><code>ε + RR* = R*</code></td><td>Equivalent to: R* = ε + R⁺</td></tr>\n            <tr><td><code>(R+S)* = (R*S*)* = (R*+S*)*</code></td><td>Star distributes over union</td></tr>\n            <tr><td><code>R + R = R</code></td><td>Union is idempotent</td></tr>\n            <tr><td><code>(RS)* = ε + R(SR)*S</code></td><td>Arden's lemma variant</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- ═══ UNIT 3 — FA ═══ -->\n    <div id=\"u3-fa\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">↔️</div>\n        <div class=\"section-title\">RE ↔ Automata Equivalence</div>\n        <span class=\"section-badge badge-purple\">Unit 3</span>\n      </div>\n\n      <div class=\"def-box green\">\n        <div class=\"def-label\">Main Theorem</div>\n        <strong>DFA = NFA = ε-NFA = Regular Expression</strong><br>\n        All describe exactly the same class: <em>Regular Languages</em>\n      </div>\n\n      <div class=\"card mt8\">\n        <div class=\"card-title\">🏗️ Thompson's Construction: RE → ε-NFA</div>\n        <div class=\"two-col\">\n          <div>\n            <strong>Base cases:</strong><br>\n            <code>∅</code> → single state, non-accepting<br>\n            <code>ε</code> → start →ε→ accept<br>\n            <code>a</code> → start →a→ accept<br><br>\n            <strong>Inductive:</strong><br>\n            <code>R+S</code> → new start with ε to both Mᴿ and Mₛ, both end with ε to new accept<br>\n            <code>RS</code> → chain Mᴿ then Mₛ via ε<br>\n            <code>R*</code> → wrap Mᴿ with ε bypass and ε back-loop\n          </div>\n          <div class=\"def-box cyan\">\n            <div class=\"def-label\">FA → RE (State Elimination)</div>\n            1. Add new start and accept states with ε<br>\n            2. Eliminate intermediate states one by one<br>\n            3. Label remaining arcs with RE<br>\n            4. Final RE = label on arc from start to accept\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <hr class=\"sep\">\n\n    <!-- ═══ PYP SOLUTIONS ═══ -->\n    <div id=\"pyp\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">📄</div>\n        <div class=\"section-title\">Previous Year Paper T1 — Full Solutions</div>\n        <span class=\"section-badge badge-amber\">16 Marks</span>\n      </div>\n\n      <!-- Q1a -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q1a · 1M</span>\n          <div class=\"pyp-q-text\">Given Σ = {x, y, z}. How many different strings of length up to 2 can be formed including the empty string?</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution</div>\n          <div class=\"tbl-wrap\">\n            <table><thead><tr><th>Length</th><th>Strings</th><th>Count</th></tr></thead>\n            <tbody>\n              <tr><td>0</td><td>ε</td><td>1</td></tr>\n              <tr><td>1</td><td>x, y, z</td><td>3</td></tr>\n              <tr><td>2</td><td>xx, xy, xz, yx, yy, yz, zx, zy, zz</td><td>9</td></tr>\n            </tbody></table>\n          </div>\n          <div class=\"formula\">Total = |Σ|⁰ + |Σ|¹ + |Σ|² = 1 + 3 + 9 = 13</div>\n        </div>\n      </div>\n\n      <!-- Q1b -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q1b · 1M</span>\n          <div class=\"pyp-q-text\">Find the prefix and suffix of length up to 3 for the string \"abaabbab\"</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution</div>\n          <div class=\"grid2\">\n            <div>\n              <strong>Prefixes (up to length 3):</strong>\n              <ul><li>ε (length 0)</li><li>a</li><li>ab</li><li>aba</li></ul>\n            </div>\n            <div>\n              <strong>Suffixes (up to length 3):</strong>\n              <ul><li>ε (length 0)</li><li>b</li><li>ab</li><li>bab</li></ul>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Q2 -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q2 · 2M</span>\n          <div class=\"pyp-q-text\">For L1={ε}, L2={a}, L3={∅}. Compute L1 · L2* ∪ L3*.</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution</div>\n          L2* = a*&nbsp;&nbsp;(all strings of a's including ε)<br>\n          L1·L2* = {ε}·a* = a*<br>\n          L3* = ∅* = {ε}&nbsp;&nbsp;(Kleene star of empty language = {ε})<br>\n          L1·L2* ∪ L3* = a* ∪ {ε} = <strong>a*</strong> (since ε ∈ a* already)\n          <div class=\"formula\">Answer: a* = {ε, a, aa, aaa, …}</div>\n        </div>\n      </div>\n\n      <!-- Q3 -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q3 · 2M</span>\n          <div class=\"pyp-q-text\">Construct DFA over Σ={a,b} accepting strings with at least one 'a' AND exactly two 'b's.</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution — 7 States</div>\n          <p>Track (b-count × has-seen-a) as 2D state. Only q₂₁ = \"2 b's AND ≥1 a\" is accepting.</p>\n          <div class=\"tbl-wrap mt8\">\n            <table><thead><tr><th>State</th><th>b-count</th><th>'a' seen?</th><th>on a</th><th>on b</th><th>Accept?</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">→ q₀₀</span></td><td>0</td><td>No</td><td>q₀₁</td><td>q₁₀</td><td></td></tr>\n              <tr><td>q₀₁</td><td>0</td><td>Yes</td><td>q₀₁</td><td>q₁₁</td><td></td></tr>\n              <tr><td>q₁₀</td><td>1</td><td>No</td><td>q₁₁</td><td>q₂₀</td><td></td></tr>\n              <tr><td>q₁₁</td><td>1</td><td>Yes</td><td>q₁₁</td><td>q₂₁</td><td></td></tr>\n              <tr><td>q₂₀</td><td>2</td><td>No</td><td>q₂₁</td><td>qd</td><td></td></tr>\n              <tr><td><strong>q₂₁</strong></td><td>2</td><td>Yes</td><td>q₂₁</td><td>qd</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>qd (dead)</td><td>3+</td><td>—</td><td>qd</td><td>qd</td><td></td></tr>\n            </tbody></table>\n          </div>\n        </div>\n      </div>\n\n      <!-- Q4 -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q4 · 2M</span>\n          <div class=\"pyp-q-text\">Construct NFA over Σ={a,b} where third symbol from right is always 'a'.</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution — 4 States | RE: (a+b)*a(a+b)(a+b)</div>\n          <div class=\"tbl-wrap\">\n            <table><thead><tr><th>State</th><th>a</th><th>b</th><th>Accept?</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">→ q₀</span></td><td>{q₀, q₁}</td><td>{q₀}</td><td></td></tr>\n              <tr><td>q₁</td><td>{q₂}</td><td>{q₂}</td><td></td></tr>\n              <tr><td>q₂</td><td>{q₃}</td><td>{q₃}</td><td></td></tr>\n              <tr><td>q₃</td><td>∅</td><td>∅</td><td class=\"td-acc\">✓</td></tr>\n            </tbody></table>\n          </div>\n          <p class=\"mt8\" style=\"font-size:13px\">q₀ non-deterministically guesses \"now\" is the 3rd from last, then tracks exactly 2 more.</p>\n        </div>\n      </div>\n\n      <!-- Q5 Page 1 -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q5a · 4M</span>\n          <div class=\"pyp-q-text\">Construct the Minimized DFA from the given DFA (A=start, E/F=accept).</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution — Mark Algorithm</div>\n          <p><strong>Step 1:</strong> Base marking (one accept, one not): mark (A,E),(A,F),(B,E),(B,F),(C,E),(C,F),(D,E),(D,F)</p>\n          <p><strong>Step 2:</strong> Check unmarked pairs:</p>\n          <ul>\n            <li>(C,D): C→E on 0, D→E on 0 → same; C→F on 1, D→F on 1 → same → <strong>C ≡ D</strong></li>\n            <li>(E,F): E→E on 0 (both accept), F→F on 0 (both accept); E→F on 1, F→F on 1 → same class → <strong>E ≡ F</strong></li>\n            <li>(A,C): A→B on 0, C→E on 0; (B,E) is marked → A≠C ✓</li>\n            <li>(A,B): A→B on 0, B→B on 0 → (B,B) unmarked; A→D on 1, B→C on 1 → (D,C)=(C,D) unmarked → <strong>A ≡ B</strong></li>\n          </ul>\n          <div class=\"tbl-wrap mt8\">\n            <table><thead><tr><th>Minimized State</th><th>0</th><th>1</th><th>Accept?</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">→ P = {A,B}</span></td><td>P</td><td>Q</td><td></td></tr>\n              <tr><td>Q = {C,D}</td><td>R</td><td>R</td><td></td></tr>\n              <tr><td>R = {E,F}</td><td>R</td><td>R</td><td class=\"td-acc\">✓</td></tr>\n            </tbody></table>\n          </div>\n        </div>\n      </div>\n\n      <!-- Q5 Page 2 -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q5b · 4M</span>\n          <div class=\"pyp-q-text\">Construct DFA from the given ε-NFA (q₀→ε→q₁→ε→q₂; q₁ loops on {0,1}; q₂: 0→q₃, 1→q₄; q₃:0→q₅; q₄:1→q₅; q₅→ε→q₆; q₆: loops on {0,1}, ε→q₇; q₆,q₇ accepting)</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution — Subset Construction (7 DFA States)</div>\n          <div class=\"tbl-wrap\">\n            <table><thead><tr><th>DFA State</th><th>NFA States</th><th>0</th><th>1</th><th>Accept?</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">A</span></td><td>{q₀,q₁,q₂}</td><td>B</td><td>C</td><td></td></tr>\n              <tr><td>B</td><td>{q₁,q₂,q₃}</td><td>D</td><td>C</td><td></td></tr>\n              <tr><td>C</td><td>{q₁,q₂,q₄}</td><td>B</td><td>E</td><td></td></tr>\n              <tr><td>D</td><td>{q₁,q₂,q₃,q₅,q₆,q₇}</td><td>D</td><td>F</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>E</td><td>{q₁,q₂,q₄,q₅,q₆,q₇}</td><td>G</td><td>E</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>F</td><td>{q₁,q₂,q₄,q₆,q₇}</td><td>G</td><td>E</td><td class=\"td-acc\">✓</td></tr>\n              <tr><td>G</td><td>{q₁,q₂,q₃,q₆,q₇}</td><td>D</td><td>F</td><td class=\"td-acc\">✓</td></tr>\n            </tbody></table>\n          </div>\n          <p class=\"mt8\" style=\"color:var(--text3);font-size:13px\">Language: (0+1)*(00+11)(0+1)* — all strings containing \"00\" or \"11\"</p>\n        </div>\n      </div>\n\n      <!-- Q6a -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q6a · 2M</span>\n          <div class=\"pyp-q-text\">Design Mealy Machine: outputs \"A\" if ends with \"10\", \"B\" if ends with \"11\", else \"C\".</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution — 2 States</div>\n          <div class=\"tbl-wrap\">\n            <table><thead><tr><th>State</th><th>Input</th><th>Output</th><th>Next State</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">→ q₀ (last≠1)</span></td><td>0</td><td>C</td><td>q₀</td></tr>\n              <tr><td><span class=\"td-start\">→ q₀</span></td><td>1</td><td>C</td><td>q₁</td></tr>\n              <tr><td>q₁ (last=1)</td><td>0</td><td style=\"color:var(--amber)\">A</td><td>q₀</td></tr>\n              <tr><td>q₁ (last=1)</td><td>1</td><td style=\"color:var(--green)\">B</td><td>q₁</td></tr>\n            </tbody></table>\n          </div>\n        </div>\n      </div>\n\n      <!-- Q6b -->\n      <div class=\"pyp-q\">\n        <div class=\"pyp-q-header\">\n          <span class=\"pyp-q-num\">Q6b · 2M</span>\n          <div class=\"pyp-q-text\">Convert the given Mealy Machine to Moore Machine (states q₀, q₂, q₃; outputs z₁, z₂).</div>\n        </div>\n        <div class=\"pyp-ans\">\n          <div class=\"pyp-ans-label\">✅ Solution — State Splitting</div>\n          <p><strong>Given Mealy:</strong> q₀:0/z₁→q₂, 1/z₁→q₃ | q₂:0/z₁→q₃, 1/z₁→q₂ | q₃:0/z₂→q₃, 1/z₁→q₂</p>\n          <p class=\"mt8\"><strong>Incoming outputs for q₃:</strong> receives z₁ (from q₀,q₂) AND z₂ (from q₃ itself) → <strong>split into q₃ᴬ(z₁) and q₃ᴮ(z₂)</strong></p>\n          <div class=\"tbl-wrap mt8\">\n            <table><thead><tr><th>Moore State</th><th>Output λ</th><th>on 0</th><th>on 1</th></tr></thead>\n            <tbody>\n              <tr><td><span class=\"td-start\">→ q₀</span></td><td>z₁</td><td>q₂</td><td>q₃ᴬ</td></tr>\n              <tr><td>q₂</td><td>z₁</td><td>q₃ᴬ</td><td>q₂</td></tr>\n              <tr><td>q₃ᴬ (arrived with z₁)</td><td>z₁</td><td>q₃ᴮ</td><td>q₂</td></tr>\n              <tr><td>q₃ᴮ (arrived with z₂)</td><td>z₂</td><td>q₃ᴮ</td><td>q₂</td></tr>\n            </tbody></table>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <hr class=\"sep\">\n\n    <!-- ═══ SAMPLE PAPERS ═══ -->\n    <div id=\"papers\" class=\"section\">\n      <div class=\"section-header\">\n        <div class=\"section-icon\">📝</div>\n        <div class=\"section-title\">Sample Question Papers (4 × 6 Questions)</div>\n        <span class=\"section-badge badge-green\">Practice</span>\n      </div>\n\n      <div class=\"paper-tabs\">\n        <div class=\"paper-tab active-tab\" onclick=\"showPaper(0)\">📄 Paper 1</div>\n        <div class=\"paper-tab\" onclick=\"showPaper(1)\">📄 Paper 2</div>\n        <div class=\"paper-tab\" onclick=\"showPaper(2)\">📄 Paper 3</div>\n        <div class=\"paper-tab\" onclick=\"showPaper(3)\">📄 Paper 4</div>\n      </div>\n\n      <!-- ═══ PAPER 1 ═══ -->\n      <div class=\"paper-content show\" id=\"paper-0\">\n        <div class=\"alert info mb4\"><div class=\"alert-icon\">📋</div><div><strong>Paper 1 — Theory & Construction Focus</strong> | Total: 14 Marks | Syllabus: Units 1, 2, 3</div></div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">1a</div>\n            <div class=\"q-title\">Given Σ = {0,1,2}, how many strings of length ≤ 3 can be formed including ε?</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">1 Mark</span><span class=\"co-badge\">CO1</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <p>Note: Σ = {0,1,2}, so |Σ| = 3.</p>\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              Total = |Σ|⁰ + |Σ|¹ + |Σ|² + |Σ|³ = 1 + 3 + 9 + 27 = <strong>40 strings</strong>\n              <div class=\"formula\">Formula: Σᵢ₌₀ⁿ |Σ|ⁱ = (|Σ|ⁿ⁺¹ − 1) / (|Σ| − 1) = (3⁴−1)/2 = 80/2 = 40</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">1b</div>\n            <div class=\"q-title\">List all prefixes and suffixes of length ≤ 2 for the string \"abba\".</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">1 Mark</span><span class=\"co-badge\">CO1</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <p>String: <code>a b b a</code></p>\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              <strong>Prefixes (len ≤ 2):</strong> ε, a, ab<br>\n              <strong>Suffixes (len ≤ 2):</strong> ε, a, ba<br>\n              <strong>Note:</strong> Prefix starts from left; suffix ends at right.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">2</div>\n            <div class=\"q-title\">For L1={a}, L2={b}, L3={ε}, compute (L1∪L2)* and L1·L2*. Are results regular languages?</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">2 Marks</span><span class=\"co-badge\">CO1</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              <strong>(L1∪L2)*</strong> = {a,b}* = all strings over {a,b} including ε<br>\n              <strong>L1·L2*</strong> = {a}·{ε,b,bb,…} = {a, ab, abb, abbb, …} = ab*<br>\n              Both are <strong>regular</strong> (described by REs: (a+b)* and ab*).\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">3</div>\n            <div class=\"q-title\">Construct a DFA over Σ = {0,1} that accepts all strings with an even number of 0s AND an even number of 1s.</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">2 Marks</span><span class=\"co-badge\">CO2</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <p>Hint: Track (parity of 0s, parity of 1s) — 4 states.</p>\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer — 4 States</div>\n              <div class=\"tbl-wrap\">\n                <table><thead><tr><th>State</th><th>#0 parity</th><th>#1 parity</th><th>0</th><th>1</th><th>Accept?</th></tr></thead>\n                <tbody>\n                  <tr><td><span class=\"td-start\">→ q₀₀</span></td><td>Even</td><td>Even</td><td>q₁₀</td><td>q₀₁</td><td class=\"td-acc\">✓</td></tr>\n                  <tr><td>q₀₁</td><td>Even</td><td>Odd</td><td>q₁₁</td><td>q₀₀</td><td></td></tr>\n                  <tr><td>q₁₀</td><td>Odd</td><td>Even</td><td>q₀₀</td><td>q₁₁</td><td></td></tr>\n                  <tr><td>q₁₁</td><td>Odd</td><td>Odd</td><td>q₀₁</td><td>q₁₀</td><td></td></tr>\n                </tbody></table>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">4</div>\n            <div class=\"q-title\">Construct an NFA over Σ = {a,b} accepting all strings that end with \"ab\".</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">2 Marks</span><span class=\"co-badge\">CO2</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <p>RE: (a+b)*ab</p>\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer — 3 States</div>\n              <div class=\"tbl-wrap\">\n                <table><thead><tr><th>State</th><th>a</th><th>b</th><th>Accept?</th></tr></thead>\n                <tbody>\n                  <tr><td><span class=\"td-start\">→ q₀</span></td><td>{q₀,q₁}</td><td>{q₀}</td><td></td></tr>\n                  <tr><td>q₁</td><td>∅</td><td>{q₂}</td><td></td></tr>\n                  <tr><td>q₂</td><td>∅</td><td>∅</td><td class=\"td-acc\">✓</td></tr>\n                </tbody></table>\n              </div>\n              q₀ loops consuming any input; on 'a' it non-deterministically also moves to q₁ (guessing this is the last 'a'), then must see 'b' to accept.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">5</div>\n            <div class=\"q-title\">Minimize the following DFA (Σ={0,1}): States {A,B,C,D,E}. Start=A, Accept={D,E}. Transitions: A:0→B,1→C | B:0→D,1→A | C:0→A,1→D | D:0→D,1→E | E:0→E,1→D</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">4 Marks</span><span class=\"co-badge\">CO2</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <p>Apply the table-filling (Mark) algorithm step by step.</p>\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              <strong>Step 1:</strong> Base marking — mark all (accept, non-accept) pairs:<br>\n              Mark: (A,D),(A,E),(B,D),(B,E),(C,D),(C,E)<br><br>\n              <strong>Step 2:</strong> Iterate for remaining pairs (A,B),(A,C),(B,C),(D,E):<br>\n              • (D,E): D:0→D, E:0→E → (D,E) again — not marked. D:1→E, E:1→D → (E,D)=(D,E) — same. → D ≡ E<br>\n              • (A,B): A:0→B, B:0→D → (B,D) marked! → A ≠ B<br>\n              • (A,C): A:0→B, C:0→A → (B,A)=(A,B): check... A:0→B, B:0→D (marked). So (A,B) marked → A ≠ C<br>\n              • (B,C): B:0→D, C:0→A → (D,A) marked → B ≠ C<br><br>\n              <strong>Result:</strong> Only D ≡ E. Merge to get 4-state minimized DFA:<br>\n              <div class=\"tbl-wrap mt8\">\n                <table><thead><tr><th>State</th><th>0</th><th>1</th><th>Accept?</th></tr></thead>\n                <tbody>\n                  <tr><td><span class=\"td-start\">→ A</span></td><td>B</td><td>C</td><td></td></tr>\n                  <tr><td>B</td><td>DE</td><td>A</td><td></td></tr>\n                  <tr><td>C</td><td>A</td><td>DE</td><td></td></tr>\n                  <tr><td>DE</td><td>DE</td><td>DE</td><td class=\"td-acc\">✓</td></tr>\n                </tbody></table>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">6</div>\n            <div class=\"q-title\">Design a Mealy Machine over {0,1} that outputs '1' if the count of 1s seen so far is divisible by 3, else '0'. Then convert it to a Moore Machine.</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">4 Marks</span><span class=\"co-badge\">CO2</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              Track count of 1s mod 3. States: q₀(0 mod 3), q₁(1 mod 3), q₂(2 mod 3)<br>\n              <strong>Mealy:</strong>\n              <div class=\"tbl-wrap mt8\">\n                <table><thead><tr><th>State</th><th>Input</th><th>Output</th><th>Next</th></tr></thead>\n                <tbody>\n                  <tr><td><span class=\"td-start\">→ q₀</span></td><td>0</td><td style=\"color:var(--green)\">1</td><td>q₀</td></tr>\n                  <tr><td>q₀</td><td>1</td><td>0</td><td>q₁</td></tr>\n                  <tr><td>q₁</td><td>0</td><td>0</td><td>q₁</td></tr>\n                  <tr><td>q₁</td><td>1</td><td>0</td><td>q₂</td></tr>\n                  <tr><td>q₂</td><td>0</td><td>0</td><td>q₂</td></tr>\n                  <tr><td>q₂</td><td>1</td><td style=\"color:var(--green)\">1</td><td>q₀</td></tr>\n                </tbody></table>\n              </div>\n              <strong>Moore conversion:</strong> q₀ has incoming outputs 1 (from q₂ via '1') and 0 (start) — split into q₀ᴬ(output=1) and q₀ᴮ(output=0). q₁ always receives 0 → keep as q₁. q₂ always receives 0 → keep as q₂.\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- ═══ PAPER 2 ═══ -->\n      <div class=\"paper-content\" id=\"paper-1\">\n        <div class=\"alert info mb4\"><div class=\"alert-icon\">📋</div><div><strong>Paper 2 — NFA & ε-NFA Focus</strong> | Total: 14 Marks | Syllabus: Units 1, 2, 3</div></div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">1a</div>\n            <div class=\"q-title\">What is the difference between a DFA and NFA? Is NFA more powerful than DFA?</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">1 Mark</span><span class=\"co-badge\">CO1</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              <strong>DFA:</strong> δ: Q×Σ→Q (exactly one next state per input). <strong>NFA:</strong> δ: Q×Σ→2^Q (zero or more next states per input).<br>\n              <strong>NO</strong> — NFA is NOT more powerful. Both accept exactly the same class: Regular Languages. Every NFA can be converted to an equivalent DFA (subset construction).\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">1b</div>\n            <div class=\"q-title\">For ε-NFA with states {q₀,q₁,q₂,q₃}: q₀→ε→q₁, q₁→ε→q₂, q₂→ε→q₃. Find ε-closure of each state.</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">1 Mark</span><span class=\"co-badge\">CO1</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              ε-closure(q₀) = {q₀, q₁, q₂, q₃} (chain of ε-transitions)<br>\n              ε-closure(q₁) = {q₁, q₂, q₃}<br>\n              ε-closure(q₂) = {q₂, q₃}<br>\n              ε-closure(q₃) = {q₃}\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">2</div>\n            <div class=\"q-title\">For L1={0,1}*, L2={00,11}. Compute L1·L2 and L2*. Describe each in words.</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">2 Marks</span><span class=\"co-badge\">CO1</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer</div>\n              <strong>L1·L2</strong> = {0,1}*·{00,11} = all binary strings ending with \"00\" or \"11\"<br>\n              <strong>L2*</strong> = {ε, 00, 11, 0000, 0011, 1100, 1111, …} = all strings that are concatenations of \"00\" and \"11\" (including empty). These are strings of even length where adjacent pairs are all 0 or all 1.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"q-card\">\n          <div class=\"q-header\" onclick=\"toggleQ(this)\">\n            <div class=\"q-num\">3</div>\n            <div class=\"q-title\">Construct a DFA over Σ = {a,b,c} accepting strings that contain exactly two 'c's.</div>\n            <div class=\"q-meta\"><span class=\"marks-badge\">2 Marks</span><span class=\"co-badge\">CO2</span></div>\n          </div>\n          <div class=\"q-body\" style=\"display:none\">\n            <button class=\"toggle-ans\" onclick=\"toggleAns(this)\">Show Answer</button>\n            <div class=\"q-ans\" style=\"display:none\">\n              <div class=\"q-ans-label\">Answer — 4 States</div>\n              <div class=\"tbl-wrap\">\n                <table><thead><tr><th>State</th><th>a,b</th><th>c</th><th>Accept?</th></tr></thead>\n                <tbody>\n                  <tr><td><span class=\"td-start\">→ q₀ (0 c's)</span></td><td>q₀</td><td>q₁</td><td></td></tr>\n                  <tr><td>q₁ (1 c)</td><td>q₁</td><td>q₂</td><td></td></tr>\n                  <tr><td>q₂ (2 c's)</td><td>q₂</td><td>qd</td><td class=\"td-acc\">✓</td></tr>\n                  <tr><td>qd (3+ c's)</td><td>qd</td><td>qd</td><td></td></tr>\n                </tbody></table>\n              </div>\n            </div>\n      